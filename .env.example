# Copy to `.env` and adjust. Every line is optional; the values shown are
# the defaults.

# --- Host side (Docker) -------------------------------------------------

# User and group Inkult runs as. Use the owner of your music directory
# (`id -u` / `id -g` on the host) so downloaded files belong to you.
PUID=1000
PGID=1000

# Where music and Inkult's state live on the host. Can be absolute paths,
# e.g. a NAS mount: MUSIC_DIR=/mnt/nas/music
MUSIC_DIR=./music
DATA_DIR=./data

# Address and port the web UI is published on. 127.0.0.1 = this machine
# only (for a reverse proxy on the same host). 0.0.0.0 = every network
# interface; Inkult speaks plain HTTP, so only do that on a network you
# trust (see "Exposing Inkult" in the README).
INKULT_HTTP_BIND=127.0.0.1
INKULT_HTTP_PORT=9876

# --- Inkult ---------------------------------------------------------------

# Domain name(s) Inkult is reached by, comma separated, no scheme or port.
# Required when using a reverse proxy with a host name; IP addresses and
# localhost always work.
INKULT_ALLOWED_HOSTS=

# Parallel downloads (1-16). Keep it low to stay friendly with providers.
INKULT_MAX_CONCURRENT_DOWNLOADS=2
INKULT_MAX_RETRIES=3
INKULT_SEARCH_LIMIT=20
INKULT_PLAYLIST_LIMIT=500
INKULT_SOULSEEK_UPLOAD_SLOTS=2
# Seconds a quality upgrade waits for a Soulseek upload to start before
# trying another copy (30-3600).
INKULT_SOULSEEK_UPGRADE_WAIT=60

# Server rules (two-factor login, authenticator name, longest track) are set
# by captains in the web UI, [7] ADMIN. These two only seed them on the very
# first start (when data/settings.json doesn't exist yet), then are ignored:
# longest track in seconds (0 = no limit), and the name authenticator apps
# show for this server, e.g. "Inkult (home)".
#INKULT_MAX_TRACK_SECS=600
#INKULT_TOTP_ISSUER=Inkult

# Your reverse proxy's address as Inkult sees it (IPs or CIDR ranges, comma
# separated), so sign-in limits apply per visitor instead of to the proxy.
# Inkult logs a warning naming the address to put here when it's missing.
INKULT_TRUSTED_PROXIES=

RUST_LOG=inkult=info
